rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'sykoratadeas2001@gmail.com'
      );
    }

    // Mediální úložiště zájezdů (_media) – zapisuje pouze admin
    match /itineraries/_media/items/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Zájezdy a vlastní itineráře
    match /itineraries/{planId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    // Galerie
    match /gallery/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);
    }

    // Uživatelé
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fórum
    match /forum_threads/{threadId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Upravit může autor vlákna, admin, nebo přihlášený uživatel přidávající odpověď (beze změny autora a názvu)
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.authorUid == request.auth.uid ||
          (request.resource.data.title == resource.data.title && request.resource.data.author == resource.data.author)
        )
      );
      allow delete: if isAdmin() || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // Rezervace
    match /reservations/{resId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Recenze
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
  }
}
